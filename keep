eport_comment: >
  This report has been generated by the <a href="https://github.com/nf-core/metaamr/tree/dev" target="_blank">nf-core/metaamr</a>
  analysis pipeline. For information about how to interpret these results, please see the
  <a href="https://nf-co.re/metaamr/dev/docs/output" target="_blank">documentation</a>.
report_section_order:
  "nf-core-metaamr-methods-description":
    order: -1000
  software_versions:
    order: -1001
  "nf-core-metaamr-summary":
    order: -1002

export_plots: true

disable_version_detection: true

# Define how MultiQC finds filtlong log files
sp:
  filtlong:
    fn: "*_filtered.log"
    contents: "Scoring long reads"
    contents_re: " "
extra_fn_clean_exts:
  - "_filtered"
  - ".assembly"
  - "_null_raw"
  - "_null"
  - "_kaiju"


  
# Set the display order for filtlong section
report_section_order:
  filtlong:
    order: 350

section_names:
  kraken: 'Centrifuge Taxonomic Classification'

module_order:
  - kraken:
      name: 'Centrifuge'


