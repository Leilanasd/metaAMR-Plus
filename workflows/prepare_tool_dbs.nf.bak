include { DOWNLOAD_DB as RESFINDER_DB_DOWNLOAD } from '../modules/local/download_db'
include { DOWNLOAD_DB as RGI_DB_DOWNLOAD } from '../modules/local/download_db'
include { RESFINDER_INDEX } from '../modules/local/RESFINDER_INDEX'
include { AMRFINDERPLUS_UPDATE } from '../modules/nf-core/amrfinderplus/update/main'
include { DOWNLOAD_DB as PLASMIDFINDER_DB_DOWNLOAD } from '../modules/local/download_db'

workflow PREPARE_TOOL_DBS {

    take:
    ch_databases

    main:

    /*
     * Extract existing DBs from database.csv channel
     * Each input item is: [ meta, file(db_path) ]
     */
    ch_resfinder_db_existing = ch_databases
        .filter { meta, db -> meta.tool == 'resfinder' }
        .map { meta, db -> db }

    ch_rgi_db_existing = ch_databases
        .filter { meta, db -> meta.tool == 'rgi' }
        .map { meta, db -> db }

    ch_amrfinderplus_db_existing = ch_databases
        .filter { meta, db -> meta.tool == 'amrfinderplus' }
        .map { meta, db -> db }

    ch_plasmidfinder_db_existing = ch_databases
        .filter { meta, db -> meta.tool == 'plasmidfinder' }
        .map { meta, db -> db }

    /*
     * If no existing DB is provided, use download flag
     */
    ch_resfinder_db_download_flag = params.download_resfinder_db ? Channel.of('resfinder') : Channel.empty()
    ch_rgi_db_download_flag = params.download_rgi_db ? Channel.of('rgi') : Channel.empty()
    ch_amrfinderplus_db_download_flag = params.download_amrfinderplus_db ? Channel.of('amrfinderplus') : Channel.empty()
    ch_plasmidfinder_db_download_flag = params.download_plasmidfinder_db ? Channel.of('plasmidfinder') : Channel.empty()

    /*
     * ResFinder
     * Existing DB from CSV OR download + index
     */
    ch_resfinder_db_branch = ch_resfinder_db_existing
        .ifEmpty(ch_resfinder_db_download_flag)
        .branch {
            to_download: it == 'resfinder'
            existing: it != 'resfinder'
        }

    ch_resfinder_db_branch.to_download | RESFINDER_DB_DOWNLOAD

    ch_indexed_resfinder_db = RESFINDER_INDEX(RESFINDER_DB_DOWNLOAD.out.db)
        .map { db_files -> file(db_files[0]).parent }

    ch_resfinder_db_final = ch_resfinder_db_branch.existing
        .mix(ch_indexed_resfinder_db)
        .first()

    /*
     * RGI
     * Existing DB from CSV OR download
     */
    ch_rgi_db_branch = ch_rgi_db_existing
        .ifEmpty(ch_rgi_db_download_flag)
        .branch {
            to_download: it == 'rgi'
            existing: it != 'rgi'
        }

    ch_rgi_db_branch.to_download | RGI_DB_DOWNLOAD

    ch_rgi_db_final = ch_rgi_db_branch.existing
        .mix(RGI_DB_DOWNLOAD.out.db)
        .first()

    /*
     * AMRFinderPlus
     * Existing DB from CSV OR download
     */
    if (params.download_amrfinderplus_db) {
        AMRFINDERPLUS_UPDATE()
        ch_amrfinderplus_db_final = ch_amrfinderplus_db_existing
            .ifEmpty(AMRFINDERPLUS_UPDATE.out.db)
            .first()
    } else {
        ch_amrfinderplus_db_final = ch_amrfinderplus_db_existing.first()
    }
 

    /*
     * PlasmidFinder
     * Existing DB from CSV OR download
     */
    ch_plasmidfinder_db_branch = ch_plasmidfinder_db_existing
        .ifEmpty(ch_plasmidfinder_db_download_flag)
        .branch {
            to_download: it == 'plasmidfinder'
            existing: it != 'plasmidfinder'
        }

    ch_plasmidfinder_db_branch.to_download | PLASMIDFINDER_DB_DOWNLOAD

    ch_plasmidfinder_db_final = ch_plasmidfinder_db_branch.existing
        .mix(PLASMIDFINDER_DB_DOWNLOAD.out.db)
        .first()

    /*
     * Debug
     */
    ch_resfinder_db_final.view { "Final ResFinder DB Path: $it" }
    ch_rgi_db_final.view { "Final RGI DB Path: $it" }
    ch_amrfinderplus_db_final.view { "Final AMRFinderPlus DB Path: $it" }
    ch_plasmidfinder_db_final.view { "Final PlasmidFinder DB Path: $it" }

    emit:
    resfinder_db     = ch_resfinder_db_final
    rgi_db           = ch_rgi_db_final
    amrfinderplus_db = ch_amrfinderplus_db_final
    plasmidfinder_db = ch_plasmidfinder_db_final
}