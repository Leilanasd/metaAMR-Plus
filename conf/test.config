/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Use as follows:
        nextflow run /path/to/metaAMR-Plus -profile test,singularity --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input
    input     = "${projectDir}/assets/test_data/samplesheet_test.csv"
    databases = "${projectDir}/assets/test_data/database_test.csv"

    // Pre-processing — skip for speed
    perform_trim        = false
    perform_hostremoval = false

    // Assembly — skip in minimal test (no assembly = reads-based mode)
    perform_assembly        = true
    perform_polish_assembly = false

    // AMR tools — only ResFinder works without assembly
    run_resfinder             = true
    download_resfinder_db     = true
    run_rgi                   = false
    run_amrfinderplus         = false
    run_abricate              = false
    run_hamronization         = false

    // Profiling — skip (requires large databases)
    run_profiling  = false
    run_centrifuge = false
    run_kaiju      = false

    // Plasmid tools — require assembly
    run_plasmidfinder = false
    run_plasclass     = true

    // Target species — not tested in minimal profile
    target_species = null

    // Save databases for reuse
    save_databases = true
}
