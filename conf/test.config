/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Use as follows:
        nextflow run nf-core/metaamrplus -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // TODO: Replace with nf-core/test-datasets URLs once test data is uploaded
    // input     = params.pipelines_testdata_base_path + 'metaamrplus/samplesheet_test.csv'
    // databases = params.pipelines_testdata_base_path + 'metaamrplus/database_test.csv'

    // Skip slow steps not needed for minimal CI test
    perform_trim            = false  // slow, well-tested by nf-core/modules
    perform_hostremoval     = false  // requires large host reference
    perform_assembly        = true   // core pipeline step
    perform_polish_assembly = false  // tested in test_full profile
    skip_quast              = false

    // AMR tools — test core tools only
    run_abricate            = true   // fast, bundled databases
    run_rgi                 = true   // core AMR tool
    run_amrfinderplus       = true   // core AMR tool
    run_resfinder           = true   // core AMR tool
    run_hamronization       = true   // test output standardisation

    // Profiling — skip, requires large databases
    run_profiling           = false
    run_centrifuge          = false
    run_kaiju               = false

    // Plasmid tools
    run_plasmidfinder       = false  // requires database
    run_plasclass           = true   // no external database needed

    // Target species mode — tested separately
    target_species          = null
}
