/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC' {
        ext.args = '--quiet'
        ext.prefix = { meta.id }
        publishDir = [
            path: { "${params.outdir}/fastqc/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    
    withName: 'PORECHOP_ABI' {
        ext.prefix = { "${meta.id}_trimmed" }
        ext.args   = ""  // Use built-in adapter database (fast). For ab initio discovery add --ab_initio via ext.args
        publishDir = [
            [
                path: { "${params.outdir}/porechop" },
                mode: params.publish_dir_mode,
                pattern: '*_trimmed.fastq.gz',
                enabled: params.save_porechop_reads
            ],
            [
                path: { "${params.outdir}/porechop" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: 'FILTLONG' {
        ext.args = [
            "--min_length ${params.filtlong_minlength}",
            "--keep_percent ${params.filtlong_keeppercent}",
            "--target_bases ${params.filtlong_targetbases}"
        ]
        .join(' ').trim()

    // Set a prefix for the output files using meta.id
        ext.prefix = { "${meta.id}_filtered" }

    // Publish output to the defined directories
        publishDir = [
            [
                path: { "${params.outdir}/filtlong" },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                enabled: params.save_filtered_reads  
            ],
            [
                path: { "${params.outdir}/filtlong" },
                mode: params.publish_dir_mode,
                pattern: '*.log'  
            ]
            
        ] 
    }

    
    withName: 'FLYE_META' {
        ext.prefix = { meta.id }
        ext.args = '--meta'
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'RACON' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/polished_assemblies/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    
    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/quast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'RESFINDER_DB_DOWNLOAD' {
        ext.tool = 'resfinder'
    }

    withName: 'RESFINDER_INDEX' {
        publishDir = [enabled: false]
    }
    
    withName: 'RGI_DB_DOWNLOAD' {
        ext.tool = 'rgi'
        
    }


    withName: 'RESFINDER_RUN' {
        ext.args = '-acq'
        publishDir = [
            path: { "${params.outdir}/resfinder/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.contains('resfinder_blast')) return null
                def parts = filename.split('/')
                return parts.size() > 1 ? parts[1..-1].join('/') : filename
            }
        ]
    }
    
    withName: 'RGI_MAIN' {
        publishDir = [
            path: { "${params.outdir}/rgi/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.startsWith('temp/') || filename.equals('temp')) return null
                return filename
            }
        ]
    }


    withName: 'RGI_CARDANNOTATION' {
        publishDir = [
            enabled: params.save_databases,
            path: { "${params.outdir}/databases/rgi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'AMRFINDERPLUS_RUN' {
        publishDir = [
            path: { "${params.outdir}/amrfinderplus/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'AMRFINDERPLUS_UPDATE' {
        publishDir = [
            enabled: params.save_databases,
            path: { "${params.outdir}/databases/amrfinderplus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'ABRICATE_RUN' {
        ext.args = { "--db ${params.arg_abricate_db}" }
        publishDir = [
            path: { "${params.outdir}/abricate/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
        
    }

    withName: 'PREPARE_HAMRONIZATION_INPUTS' {
        publishDir = [enabled: false]
    }
    
    withName: 'HAMRONIZATION_ABRICATE' {
        publishDir = [
            path: { "${params.outdir}/hamronization/abricate/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
    }

    withName: 'HAMRONIZATION_AMRFINDERPLUS' {
        publishDir = [
            path: { "${params.outdir}/hamronization/amrfinderplus/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
    }

    withName: 'HAMRONIZATION_RGI' {
        publishDir = [
            path: { "${params.outdir}/hamronization/rgi/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
    }

    withName: 'HAMRONIZATION_SUMMARIZE' {
        publishDir = [
            path: { "${params.outdir}/hamronization/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
    }

    withName: 'VALIDATE_FASTA' {
        errorStrategy = 'ignore'
        publishDir = [enabled: false]
    }
    
    withName: 'PLASMIDFINDER' {
        publishDir = [
            path: { "${params.outdir}/plasmidfinder" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) null
                else filename
            }
        ]
        ext.prefix = { "${meta.id}_plasmidfinder" }
    }
    
    withName: 'PLASCLASS' {
        publishDir = [
            path: { "${params.outdir}/plasclass" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { "${meta.id}" }
    }

    
    withName: 'KAIJU_KAIJU' {
        publishDir = [
            path: { "${params.outdir}/kaiju/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KAIJU_KAIJU2TABLE' {
        publishDir = [
            path: { "${params.outdir}/kaiju/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KAIJU_KAIJU2KRONA' {
        publishDir = [ enabled: false ]
    }

    withName: 'CENTRIFUGE_CENTRIFUGE' {
        publishDir = [
            path: { params.target_species ? "${params.outdir}/target_species/centrifuge/${meta.id}" : "${params.outdir}/centrifuge/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CENTRIFUGE_KREPORT' {
        publishDir = [
            path: { params.target_species ? "${params.outdir}/target_species/centrifuge/${meta.id}" : "${params.outdir}/centrifuge/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KRONA_KAIJU' {
        ext.prefix = { "${meta.id}_kaiju_krona" }
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KRONA_CENTRIFUGE' {
        ext.prefix = { "${meta.id}_centrifuge_krona" }
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
     

    withName:  'COMBINE_CONTIGS_AND_SPECIES' {
        publishDir = [
            path: { "${params.outdir}/centrifuge/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'MINIMAP2_INDEX' {
        ext.args   = '-x map-ont'
        publishDir = [
            path: { "${params.outdir}/host_removal/index" },
            mode: params.publish_dir_mode,
            pattern: '*.mmi',
            enabled: params.save_hostremoval_index
        ]
    }

    withName: 'MINIMAP2_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/host_removal" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            enabled: params.save_hostremoval_bam
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix  = { "${meta.id}.sorted" }
        ext.args    = "--write-index"
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_VIEW' {
        ext.args = '-f 4'
        ext.prefix = { "${meta.id}.unmapped" }
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/host_removal" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz',
            enabled: params.save_hostremoval_unmapped
        ]
    }

    withName: 'RESFINDER_WITH_SPECIES' {
        publishDir = [
            path: { "${params.outdir}/target_species/amr_results" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'FILTER_READS_BY_SPECIES' {
        publishDir = [
            path: { "${params.outdir}/target_species/classification" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) return null
                if (filename.endsWith('.filtered_reads.txt')) return null
                return filename
            }
        ]
    }

    withName: 'EXTRACT_FILTERED_READS' {
        publishDir = [
            path: { "${params.outdir}/target_species/extracted_reads" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GENERATE_REPORT' {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}


