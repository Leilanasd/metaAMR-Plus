/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC'{
        ext.args = '--quiet'
        ext.prefix = { meta.id }
        publishDir = [
            path: { "${params.outdir}/fastqc/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    
    withName: 'PORECHOP '{
        ext.prefix = { "${meta.id}_${meta.run_accession}" }
        publishDir = [
            [
                path: { "${params.outdir}/porechop" },
                mode: params.publish_dir_mode,
                pattern: '*_porechopped.fastq.gz',
                
            ],
            [
                path: { "${params.outdir}/porechop" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/ch_trimmed_for_filtlong" },
                mode: params.publish_dir_mode,
                pattern: '*_porechopped.fastq.gz',
                
            ]
        ]
    }

    withName: 'FILTLONG' {
        ext.args = [
            "--min_length ${params.filtlong_minlength}",
            "--keep_percent ${params.filtlong_keeppercent}",
            "--target_bases ${params.filtlong_targetbases}"
        ]
        .join(' ').trim()

    // Set a prefix for the output files using meta.id
        ext.prefix = { "${meta.id}_filtered" }

    // Publish output to the defined directories
        publishDir = [
            [
                path: { "${params.outdir}/filtlong" },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                enabled: params.save_filtered_reads  
            ],
            [
                path: { "${params.outdir}/filtlong" },
                mode: params.publish_dir_mode,
                pattern: '*.log'  
            ]
            
        ] 
    }

    
    withName: 'FLYE_META' {
        ext.prefix = { meta.id }
        ext.args = '--meta'
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'RACON' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/polished_assemblies/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        maxForks = 3
        cpus = 8
        memory = '16 GB'
        time = '4h'
    }

    
    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/quast/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    } 


    withName: 'DOWNLOAD_DB' {
        publishDir = [
            path: { "${params.outdir}/databases/${task.ext.tool}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RESFINDER_DB_DOWNLOAD' {
        ext.tool = 'resfinder'
    }

    withName: 'RESFINDER_INDEX' {
        publishDir = [enabled: false]
    }
    
    withName: 'RGI_DB_DOWNLOAD' {
        ext.tool = 'rgi'
        publishDir = [
            path: { "${params.outdir}/databases/rgi" },
            mode: params.publish_dir_mode,
            pattern: '*_db'
        ]
    }

    withName: 'AMRFINDERPLUS_UPDATE' {
        publishDir = [
            path: { "${params.outdir}/databases/amrfinderplus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLASMIDFINDER_DB_DOWNLOAD' {
        ext.tool = 'plasmidfinder'
    }

    withName: 'RESFINDER_RUN' {
        ext.args = '-acq'
        publishDir = [
            path: { "${params.outdir}/resfinder/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.contains('resfinder_blast')) return null
                def parts = filename.split('/')
                return parts.size() > 1 ? parts[1..-1].join('/') : filename
            }
        ]
    }
    
    withName: 'RGI_MAIN' {
        publishDir = [
            path: { "${params.outdir}/rgi/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.startsWith('temp/') || filename.equals('temp')) return null
                return filename
            }
        ]
    }


    withName: 'RGI_CARDANNOTATION' {
        publishDir = [
            path: { "${params.outdir}/databases/rgi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'AMRFINDERPLUS_RUN' {
        publishDir = [
            path: { "${params.outdir}/amrfinderplus/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'ABRICATE_RUN' {
        ext.args = '--db vfdb'
        publishDir = [
            path: { "${params.outdir}/abricate/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
        
    }

    withName: 'PREPARE_HAMRONIZATION_INPUTS' {
        publishDir = [enabled: false]
    }
    
    withName: 'HAMRONIZATION_ABRICATE' {
        publishDir = [
            path: { "${params.outdir}/hamronization/abricate/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
    }

    withName: 'HAMRONIZATION_AMRFINDERPLUS' {
        publishDir = [
            path: { "${params.outdir}/hamronization/amrfinderplus/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
    }

    withName: 'HAMRONIZATION_RGI' {
        publishDir = [
            path: { "${params.outdir}/hamronization/rgi/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
    }

    withName: 'HAMRONIZATION_SUMMARIZE' {
        publishDir = [
            path: { "${params.outdir}/hamronization/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
    }

    withName: 'VALIDATE_FASTA' {
        publishDir = [enabled: false]
    }
    
    withName: 'PLASMIDFINDER_RUN' {
        publishDir = [
            path: { "${params.outdir}/plasmidfinder/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) null
                else filename
            },
            failOnError: false
        ]
    }
    
    withName: 'PLASCLASS' {
        publishDir = [
            path: { "${params.outdir}/plasclass/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    
    withName: 'PLASCLASS_POSTPROCESS' {
        publishDir = [
            path: { "${params.outdir}/plasclass/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'KAIJU_KAIJU' {
        publishDir = [
            path: { "${params.outdir}/kaiju/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        cpus = 8
        time = { check_max( 8.h * task.attempt, 'time' ) }
        maxRetries = 3
    }
    withName: 'KAIJU_KAIJU2TABLE' {
        publishDir = [
            path: { "${params.outdir}/kaiju/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KAIJU_KAIJU2KRONA' {
        publishDir = [enabled: false]
    }
    
    withName: 'CENTRIFUGE_CENTRIFUGE' {
        publishDir = [
            path: { "${params.outdir}/centrifuge/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CENTRIFUGE_KREPORT' {
        publishDir = [
            path: { "${params.outdir}/centrifuge/${meta.id}/kreport" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    
    withName: 'KRONA_.*' {
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:  "COMBINE_CONTIGS_AND_SPECIES" {
        publishDir = [
            path: { "${params.outdir}/centrifuge/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'MINIMAP2_INDEX' {
        publishDir = [enabled: false]
    }

    withName: 'MINIMAP2_ALIGN' {
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix  = { "${meta.id}.sorted" }
        ext.args    = "--write-index"
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_VIEW' {
        ext.args = '-f 4'
        ext.prefix = { "${meta.id}_${meta.run_accession}.unmapped" }
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [enabled: false]
    }

    withName: 'SAMTOOLS_FASTQ' {
        publishDir = [enabled: false]
    }



    withName: 'FILTER_READS_BY_SPECIES' {
        publishDir = [
            path: { "${params.outdir}/target_species/species_filtering/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_FILTERED_READS' {
        publishDir = [
            path: { "${params.outdir}/target_species/filtered_reads/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}


